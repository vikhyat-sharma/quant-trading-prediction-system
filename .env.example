# ============================================================
# Quant Trading Prediction System — Environment Configuration
# Copy this file to .env and fill in the required values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
# Required: TCP port the HTTP server listens on.
PORT=8080

# ── Database ─────────────────────────────────────────────────
# Required: PostgreSQL connection string.
# Use sslmode=require in production.
DATABASE_URL=postgres://user:password@localhost:5432/quant_trading?sslmode=disable

# ── Authentication ───────────────────────────────────────────
# Required in staging/production: secret used to sign JWT tokens.
# Generate with: openssl rand -hex 32
# Must be at least 32 characters. Never use the example value in production.
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars

# ── Environment ──────────────────────────────────────────────
# Required: one of development | staging | production
ENVIRONMENT=development

# ── Logging ──────────────────────────────────────────────────
# Optional: one of debug | info | warn | error (default: info)
LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────
# Optional: allowed origin for CORS (default: * — restrict in production)
# Example: CORS_ALLOW_ORIGIN=https://app.example.com
CORS_ALLOW_ORIGIN=*
